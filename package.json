{
  "name": "manualiq",
  "version": "0.1.0",
  "private": true,
  "description": "Chat with your manuals and your databases: hybrid search with page citations, a guarded text-to-SQL agent, and a router that picks the right source.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "setup": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/setup.mjs",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server/index.js",
    "ingest-inbox": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/ingest_inbox.mjs",
    "ingest-bulk": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/ingest_bulk.mjs",
    "fixtures": "node --disable-warning=ExperimentalWarning test/make_fixtures.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.mjs\""
  }
}
