# Copy to .env (npm run setup does this for you). Every value here is the default; delete lines you don't change.
# Never put real secrets in .env.example.

# ---- What the app is about (shown in the page title; one line of context for the model)
APP_NAME=ManualIQ
APP_CONTEXT=
# Example questions on the start screen, separated by |
SAMPLE_QUESTIONS=

# ---- Server
PORT=5623
HOST=127.0.0.1            # 0.0.0.0 opens it to your local network

# ---- Connecting to Claude (the app runs the Claude Code CLI, `claude -p`)
# Either log in once with `claude` (uses your Claude plan), or set an API key here (pay per answer, needed when
# other people use your instance). A key here wins over the login. Keep it out of git: .env is ignored.
# ANTHROPIC_API_KEY=sk-ant-...
# Amazon Bedrock / Google Vertex AI / Microsoft Foundry: add the variables from
# https://code.claude.com/docs/en/authentication (e.g. CLAUDE_CODE_USE_BEDROCK=1 plus your AWS settings).

# ---- Models
CLAUDE_MODEL=sonnet       # answers: haiku | sonnet | opus | a full model id
SQL_MODEL=sonnet          # question -> SQL
ROUTER_MODEL=haiku        # manuals / database / both
# CLAUDE_BIN=             # path to claude / claude.exe if it isn't found automatically
CLAUDE_TIMEOUT_MS=360000

# ---- Manual search
EMBED_MODEL=BAAI/bge-small-en-v1.5   # local embedding model (fastembed, CPU). Changing it needs a full re-embed.
BUDGET_TOKENS=24000                  # document text sent per question
BUDGET_MORE_TOKENS=40000             # per "More detail" turn
WHOLE_MANUAL_MAX_TOKENS=60000        # largest manual sent whole
# HYBRID=0                           # keyword search only (no vectors)

# ---- Databases (SQL agent)
SQL_EXECUTE=true          # false = show the SQL, never run it
SQL_MAX_ROWS=100          # LIMIT the guard enforces
SQL_TIMEOUT_MS=5000       # a query running longer is stopped
SQL_SHOW_ROWS=20          # rows shown under an answer
MAX_UPLOAD_MB=200

# ---- Paths
# PDF_DIR=                # a folder of PDFs for `npm run ingest-bulk` (default data/pdfs)
# PYTHON=                 # Python to use (default: .venv made by setup, else python/python3)
